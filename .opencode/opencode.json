{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "permission": {
    "edit": {
      "*": "allow",
      ".github/workflows/**": "deny",
      "**/*.env*": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "./mvnw test*": "allow",
      "./mvnw verify": "allow",
      "./mvnw.cmd test*": "allow",
      "./mvnw.cmd verify": "allow",
      "docker compose*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    }
  },
  "mcp": {
    "finbank-mcp": {
      "type": "local",
      "command": [".venv/Scripts/python.exe", "./finbank-mcp/server.py"],
      "enabled": true
    }
  }
}
